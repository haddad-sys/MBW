# متابِع · Mutabea — configuration
# Copy to .env and edit. Anything already in the environment wins over this file,
# so a container can inject secrets without writing them to disk.

# ---------------------------------------------------------------- server ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Used to build the "open the note" link inside every email.
APP_URL=http://localhost:3000
ORG_NAME=متابِع

# Set a real secret in production — without one, sessions do not survive a restart.
JWT_SECRET=
JWT_TTL=12h
# Send session cookies only over HTTPS. Defaults to on when NODE_ENV=production.
SECURE_COOKIES=false
BCRYPT_ROUNDS=10

DB_FILE=./data/mutabea.db

# ------------------------------------------------------- the first account --
# Created once, on an empty database, so somebody can approve the first
# application. Change the password immediately after the first sign-in.
OWNER_USERNAME=manager
OWNER_PASSWORD=Manager@2026
OWNER_NAME=د. هاني
OWNER_EMAIL=hani.alhaddad@gmail.com

# Four demo branches and a handful of notes on first boot. Turn off for a
# production database.
SEED_DEMO=true

# ---------------------------------------------------------- registration ----
# Self-service applications. Every application waits for an approval either way;
# turning this off removes the form entirely.
REGISTRATION_OPEN=true
# Optional allow-list, comma separated. Empty means any address may apply.
ALLOWED_EMAIL_DOMAINS=

# ------------------------------------------------------------- scheduler ----
# The background engine: due-soon and overdue detection, and the mail flush.
SCHEDULER_ENABLED=true
TICK_SECONDS=300
# Days before the due date that the automatic reminder fires.
DUE_SOON_DAYS=1

# ------------------------------------------------------------------ mail ----
# smtp   — a real mail server, configured below
# json   — nothing leaves the process; messages are still rendered and logged
# stream — same, but the full RFC822 message is built
MAIL_TRANSPORT=json

# Setting SMTP_HOST switches MAIL_TRANSPORT to smtp automatically.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

MAIL_FROM=متابِع <no-reply@mutabea.local>
MAIL_REPLY_TO=
MAIL_MAX_ATTEMPTS=3
MAIL_RETRY_SECONDS=120

# Staging guard rail: when set, every recipient is rewritten to this address so a
# copy of production data cannot mail real people.
MAIL_REDIRECT_ALL=

# --------------------------------------------------------------- uploads ----
# Photographs and documents are stored inline, so the JSON body limit is the
# real upload limit.
MAX_UPLOAD_BYTES=3145728
JSON_LIMIT=12mb
