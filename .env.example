# متابع · Mutabi — configuration
# Copy to .env and edit. Anything already in the environment wins over this file,
# so a container can inject secrets without writing them to disk.

# ---------------------------------------------------------------- server ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Used to build the "open the task" link inside every email.
APP_URL=http://localhost:3000
ORG_NAME=Mutabi
ORG_NAME_AR=متابع

# Sign a real secret in production — without one, sessions do not survive a restart.
JWT_SECRET=
JWT_TTL=12h
# Send session cookies only over HTTPS. Defaults to on when NODE_ENV=production.
SECURE_COOKIES=false

DB_FILE=./data/mutabi.db

# ------------------------------------------------------------- scheduler ----
# The background engine: reminders, overdue detection, escalation, mail flush.
SCHEDULER_ENABLED=true
TICK_SECONDS=60
# Days before the due date that the automatic reminder fires.
REMINDER_LEAD_DAYS=1
# Days a task may stay overdue before it escalates to the assignee's manager.
ESCALATION_DAYS=3

# ------------------------------------------------------------------ mail ----
# smtp   — a real mail server, configured below
# json   — nothing leaves the process; messages are still rendered and logged
# stream — same, but the full RFC822 message is built
MAIL_TRANSPORT=json

# Set SMTP_HOST and MAIL_TRANSPORT switches to smtp automatically.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

MAIL_FROM=Mutabi <no-reply@mutabi.local>
MAIL_REPLY_TO=
MAIL_MAX_ATTEMPTS=3
MAIL_RETRY_SECONDS=120

# Staging guard rail: when set, every recipient is rewritten to this address so a
# copy of production data cannot mail real people.
MAIL_REDIRECT_ALL=

# --------------------------------------------------------- quiet hours ------
# The default window for a new account. Each person can change their own.
QUIET_FROM=21:00
QUIET_TO=07:00

# ------------------------------------------------------------------ seed ----
# Password given to every demo account by `npm run seed`.
SEED_PASSWORD=Mutabi#2026
